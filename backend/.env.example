# template for environment variables in the backend Node.js application, providing placeholders for database connection string, LLM API key and model, server port and environment, and frontend URL for CORS. This file should be copied to .env and updated with actual values before running the application.

# Database
DATABASE_URL=postgresql://user:password@host/database

# LLM Provider Keys
# Only configure the provider you intend to use

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter (alternative)
OPENROUTER_API_KEY=your_openrouter_key_here

# Model Selection
# Examples:
# claude-sonnet-4-20250514
# openrouter/auto
# google/gemini-2.0-flash-exp:free

LLM_MODEL=claude-sonnet-4-20250514
DETECTION_MODEL=openrouter/auto


# Privacy Controls

PRIVACY_MODE=true
ENABLE_SECONDARY_DETECTION=true
DETECTION_TIMEOUT=120000


# Application Settings

PORT=3001
NODE_ENV=development

APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173